{{- $domain := printf "%s.svc.%s" .Release.Namespace .Values.clusterDomain -}}
resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
resolver_timeout 3s;

upstream nifi {
    zone nifi 64k;
    server {{ .Values.nifi.host | default (printf "cogstack-nifi.%s" $domain) }}:{{ .Values.nifi.port }} resolve;
}
upstream opensearch {
    zone opensearch 64k;
    server {{ .Values.opensearch.host | default (printf "opensearch-cluster-master.%s" $domain) }}:{{ .Values.opensearch.port }} resolve;
}
upstream dashboards {
    zone dashboards 64k;
    server {{ .Values.dashboards.host | default (printf "opensearch-dashboards.%s" $domain) }}:{{ .Values.dashboards.port }} resolve;
}

map $request_port $nifi_public_port {
    "" 443;
    default $request_port;
}

server {
    listen {{ .Values.nginx.internalPort }} ssl;
    server_name ${NGINX_NIFI_SERVER_NAME};
    ssl_certificate /certificates/tls.crt;
    ssl_certificate_key /certificates/tls.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    absolute_redirect off;

    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $remote_addr;

    location = / { return 302 /nifi/; }
    location = /nifi { return 308 /nifi/; }

    location /opensearch/ {
        client_max_body_size 100m;
        proxy_pass http://opensearch/;
    }

    location /dashboards/ {
        proxy_pass http://dashboards;
    }

    location / {
        auth_basic "NiFi";
        auth_basic_user_file /etc/nginx/nifi-auth/htpasswd;
        proxy_set_header Authorization "";
        proxy_set_header Host $http_host;
        proxy_set_header X-ProxyHost $host;
        proxy_set_header X-ProxyPort $nifi_public_port;
        proxy_set_header X-ProxyScheme $scheme;
        proxy_set_header X-ProxyContextPath "";
        proxy_set_header X-Forwarded-Context "";
        proxy_set_header X-Forwarded-Prefix "";
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_redirect http://$http_host/ /;
        proxy_pass http://nifi;
    }
}
