# NiFi sample credentials for Docker development and k3s-load-auth-nifi.
# Environment values override these defaults.
NIFI_SINGLE_USER_CREDENTIALS_USERNAME="${NIFI_SINGLE_USER_CREDENTIALS_USERNAME:-admin}"
NIFI_SINGLE_USER_CREDENTIALS_PASSWORD="${NIFI_SINGLE_USER_CREDENTIALS_PASSWORD:-cogstackNiFi}"

# Store passwords are configured in certificates.env.
NIFI_INITIAL_ADMIN_IDENTITY=${NIFI_INITIAL_ADMIN_IDENTITY:-$NIFI_SINGLE_USER_CREDENTIALS_USERNAME}
NIFI_SENSITIVE_PROPS_KEY=${NIFI_SENSITIVE_PROPS_KEY:-c6063c770f5a281732877e7a9f7de2bc}

# OpenSearch passwords for kibanaserver, nifi, cogstack_pipeline and cogstack_user.
OPENSEARCH_KIBANA_PASSWORD=${OPENSEARCH_KIBANA_PASSWORD:-demo}
OPENSEARCH_NIFI_PASSWORD=${OPENSEARCH_NIFI_PASSWORD:-demo}
OPENSEARCH_PIPELINE_PASSWORD=${OPENSEARCH_PIPELINE_PASSWORD:-demo}
OPENSEARCH_ANALYST_PASSWORD=${OPENSEARCH_ANALYST_PASSWORD:-demo}
