# Local NiFi credentials for k3s-load-auth-nifi, using development sample values.
NIFI_SINGLE_USER_CREDENTIALS_USERNAME=admin
NIFI_SINGLE_USER_CREDENTIALS_PASSWORD=cogstackNiFi

# Helm loads the JKS passwords from certificates.env.
NIFI_INITIAL_ADMIN_IDENTITY=${NIFI_INITIAL_ADMIN_IDENTITY:-$NIFI_SINGLE_USER_CREDENTIALS_USERNAME}
NIFI_SENSITIVE_PROPS_KEY=${NIFI_SENSITIVE_PROPS_KEY:-c6063c770f5a281732877e7a9f7de2bc}
