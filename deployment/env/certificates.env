# Certificate generator settings with development store passwords.
# Blank settings use the script defaults. Use --days DAYS to set validity.
#
# The certificate Make targets load this file automatically.
# For a direct generator invocation, load it from the repository root.
#   set -a
#   source deployment/env/general.env
#   source deployment/env/certificates.env
#   set +a

# Blank uses deployment/security/ for certificate inputs and outputs.
SECURITY_DIR="${SECURITY_DIR:-}"

# Optional names to add to the NiFi certificate. Match the names NGINX and the
# health check verify in the deployment.
NIFI_UPSTREAM_TLS_NAME="${NIFI_UPSTREAM_TLS_NAME:-}"
NIFI_HEALTHCHECK_HOST="${NIFI_HEALTHCHECK_HOST:-}"

# Browser-facing NGINX DNS names or IP addresses, comma-separated.
# Blank uses localhost,127.0.0.1.
NGINX_TLS_NAMES="${NGINX_TLS_NAMES:-}"

# Optional comma-separated DNS aliases for each OpenSearch node and for Dashboards.
OPENSEARCH_NODE_DNS_NAMES="${OPENSEARCH_NODE_DNS_NAMES:-}"
OPENSEARCH_DASHBOARDS_DNS_NAMES="${OPENSEARCH_DASHBOARDS_DNS_NAMES:-}"

# Development store passwords. Environment values override these defaults.
NIFI_KEYSTORE_PASSWORD=${NIFI_KEYSTORE_PASSWORD:-cogstack}
NIFI_TRUSTSTORE_PASSWORD=${NIFI_TRUSTSTORE_PASSWORD:-cogstack}
OPENSEARCH_CERTIFICATE_PASSWORD=${OPENSEARCH_CERTIFICATE_PASSWORD:-${OS_CERTIFICATE_PASSWORD:-cogstack}}
ROOT_CERTIFICATE_KEYSTORE_PASSWORD="${ROOT_CERTIFICATE_KEYSTORE_PASSWORD:-cogstackNiFi}"
