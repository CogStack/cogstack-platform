########################################################################## OpenSearch Dashboards Env vars ###########################################################################

OPENSEARCH_DASHBOARDS_HOST="https://kibana:5601"

# possible values:
#   - opensearch                            : opensearchproject/opensearch-dashboards:3.9.0
# the custom cogstack image is always based on the last image of ES native

OPENSEARCH_DASHBOARDS_DOCKER_IMAGE=opensearchproject/opensearch-dashboards:3.9.0@sha256:256d4cea5928868ac09bca642a0ac8285a2b7e4b7fdd45c4ec06e75a5cf3184c

OPENSEARCH_DASHBOARDS_SERVER_NAME="cogstack-opensearch-dashboards"
OPENSEARCH_DASHBOARDS_PUBLIC_BASE_URL="https://elasticsearch-1:5601"

OPENSEARCH_DASHBOARDS_SERVER_HOST="0.0.0.0"
OPENSEARCH_DASHBOARDS_SERVER_OUTPUT_PORT=5601

OPENSEARCH_DASHBOARDS_DOCKER_SHM_SIZE=512m
OPENSEARCH_DASHBOARDS_DOCKER_CPU_MIN=1
OPENSEARCH_DASHBOARDS_DOCKER_CPU_MAX=1
OPENSEARCH_DASHBOARDS_DOCKER_RAM=1g
