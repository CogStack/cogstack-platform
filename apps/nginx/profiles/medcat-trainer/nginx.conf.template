# Adapted from deployment/charts/medcat-trainer/templates/nginx-configmap.yaml.
resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
resolver_timeout 3s;
upstream medcat {
    zone medcat 64k;
    server ${MEDCAT_UPSTREAM_HOST}:${MEDCAT_UPSTREAM_PORT} resolve;
}
upstream medcat_solr {
    zone medcat_solr 64k;
    server ${MEDCAT_SOLR_HOST}:${MEDCAT_SOLR_PORT} resolve;
}

server {
    listen 127.0.0.1:${NGINX_HEALTH_PORT};
    access_log off;
    location = /healthz/live { return 200 'ok\n'; }
    location = /healthz/ready {
        proxy_set_header Host localhost;
        proxy_connect_timeout 3s;
        proxy_read_timeout 3s;
        proxy_pass http://medcat/api/health/ready/;
    }
}

server {
    listen ${MEDCAT_LISTEN_PORT};
    server_name ${MEDCAT_SERVER_NAME};
    charset utf-8;
    large_client_header_buffers 4 32k;
    client_max_body_size 4000m;
    proxy_connect_timeout 3000s;
    proxy_send_timeout 3000s;
    proxy_read_timeout 3000s;
    send_timeout 3000s;
    keepalive_timeout 3000s;

    gzip on;
    gzip_comp_level 5;
    gzip_min_length 256;
    gzip_proxied any;
    gzip_vary on;
    gzip_types application/atom+xml application/javascript application/json
        application/ld+json application/manifest+json application/rss+xml
        application/vnd.geo+json application/vnd.ms-fontobject application/x-font-ttf
        application/x-web-app-manifest+json application/xhtml+xml application/xml
        font/opentype image/bmp image/svg+xml image/x-icon text/cache-manifest
        text/css text/plain text/vcard text/vnd.rim.location.xloc text/vtt
        text/x-component text/x-cross-domain-policy;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    location = /static { return 301 /static/; }
    location /static/ { alias "${MEDCAT_STATIC_ROOT}/"; }
    location = /media { return 301 /media/; }
    location /media/ { alias "${MEDCAT_MEDIA_ROOT}/"; }
    location /api/concepts/ { proxy_pass http://medcat_solr/solr/; }
    location / { proxy_pass http://medcat; }
    location = /nginx/health/live { access_log off; return 200 'OK'; }
}
