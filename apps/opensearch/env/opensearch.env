# Based on CogStack-NiFi deploy/elasticsearch.env.
# Supply credentials and encryption keys through your private deployment settings.
####################################################################### OpenSearch Env vars #######################################################################

# possible values :
#   - elasticsearch                         : docker.elastic.co/elasticsearch/elasticsearch:9.5.2
#   - elasticsearch (custom cogstack image) : cogstacksystems/cogstack-elasticsearch:latest 
#   - opensearch                            : opensearchproject/opensearch:3.9.0
# the custom cogstack image is always based on the last image of ES native 

OPENSEARCH_DOCKER_IMAGE=opensearchproject/opensearch:3.9.0@sha256:3b55f6b6249cfdb92b52ee59adc8a266203ba9ef9f5d82544fad6f1af2f3609e

OPENSEARCH_LOG_LEVEL=INFO

OPENSEARCH_SEED_HOSTS=localhost,elasticsearch-2,elasticsearch-1
OPENSEARCH_INITIAL_CLUSTER_MANAGER_NODES=es01


OPENSEARCH_NETWORK_HOST="0.0.0.0"
OPENSEARCH_NETWORK_PUBLISH_HOST="0.0.0.0"

OPENSEARCH_NODE_1_OUTPUT_PORT=9200
OPENSEARCH_NODE_2_OUTPUT_PORT=9201
OPENSEARCH_NODE_3_OUTPUT_PORT=9202

# cluster communication port
OPENSEARCH_NODE_1_COMM_OUTPUT_PORT=9300
OPENSEARCH_NODE_2_COMM_OUTPUT_PORT=9301
OPENSEARCH_NODE_3_COMM_OUTPUT_PORT=9302

# cluster analyzer port
OPENSEARCH_NODE_1_ANALYZER_OUTPUT_PORT=9600
OPENSEARCH_NODE_2_ANALYZER_OUTPUT_PORT=9601
OPENSEARCH_NODE_3_ANALYZER_OUTPUT_PORT=9602

# do not change these values unless you want to create new volumes manually in services.yml
# or you have a special case where you need to switch volumes
OPENSEARCH_NODE_1_DATA_VOL_NAME=elasticsearch-vol-1
OPENSEARCH_NODE_2_DATA_VOL_NAME=elasticsearch-vol-2
OPENSEARCH_NODE_3_DATA_VOL_NAME=elasticsearch-vol-3

# log volumes shared between filebeat and elasticsearch
OPENSEARCH_NODE_1_LOG_VOL_NAME=elasticsearch-vol-log-1
OPENSEARCH_NODE_2_LOG_VOL_NAME=elasticsearch-vol-log-2
OPENSEARCH_NODE_3_LOG_VOL_NAME=elasticsearch-vol-log-3

# Performance Analyzer volumes (OpenSearch)
OPENSEARCH_NODE_1_PA_VOL_NAME=elasticsearch-vol-performance-analyzer-1
OPENSEARCH_NODE_2_PA_VOL_NAME=elasticsearch-vol-performance-analyzer-2
OPENSEARCH_NODE_3_PA_VOL_NAME=elasticsearch-vol-performance-analyzer-3

# this is for native ES 
# possible values:
#   - trial  # 30 day trial
#   - basic

OPENSEARCH_LICENSE_TYPE="trial"

OPENSEARCH_SSL_ENABLED=true

OPENSEARCH_CLUSTER_NAME="elasticsearch-cogstack-cluster"

# the node names can be the same as the $ES_INSTANCE_NAME_1 variables set in security/certificates_elasticsearch.env
OPENSEARCH_NODE_1_NAME=es01
OPENSEARCH_NODE_2_NAME=es02
OPENSEARCH_NODE_3_NAME=es03

# corresponds to "node.attr.rack="
OPENSEARCH_NODE_ATTR="elastic"

OPENSEARCH_CORS_ENABLED="true"

OPENSEARCH_HTTP_PORT=9200

# this setting represents the number of CPUS allocated to each cluster.
OPENSEARCH_NODE_PROCESSORS="2"

OPENSEARCH_BACKUPS_PATH_REPO=["/mnt/es_data_backups","/mnt/es_config_backups"]

# used for full snapshot backup
# this is the path on the physical drive, not inside the container
OPENSEARCH_BACKUP_PARTITION_FULL=/data/es_snapshot_backups/full_backup

# this is the path on the physical drive, not inside the container
# used for snapshot backups of configs
OPENSEARCH_BACKUP_PARTITION_CONFIG=/data/es_snapshot_backups/config_backup

# Security certificates
OPENSEARCH_SECURITY_DIR=../security/certificates/elastic/

# MEMORY CONFIG
OPENSEARCH_JAVA_OPTS="-Xms512m -Xmx512m -Des.failure_store_feature_flag_enabled=true --enable-native-access=ALL-UNNAMED"
ES_JAVA_OPTS=$OPENSEARCH_JAVA_OPTS

OPENSEARCH_DOCKER_CPU_MIN=1
OPENSEARCH_DOCKER_CPU_MAX=1
# Leave room beyond the Java heap for direct buffers, native code, and plugins.
# OpenSearch 3.9 exceeds a 1 GiB container limit during plugin initialization.
OPENSEARCH_DOCKER_RAM=2g

OPENSEARCH_DOCKER_SHM_SIZE=512m

OPENSEARCH_DOCKER_LOG_SIZE_PER_FILE="1000m"
OPENSEARCH_DOCKER_LOG_NUM_FILES=10

# OpenSearch ML Commons bootstrap settings. Connector timeouts are seconds;
# the Dashboards opensearch.requestTimeout setting is milliseconds.
OPENSEARCH_AI_OPENSEARCH_CONTAINER=elasticsearch-1
# Local development credentials; update these when the OpenSearch admin login
# is rotated or override them when invoking the bootstrap script.
OPENSEARCH_AI_OPENSEARCH_USER=admin
# OPENSEARCH_AI_OPENSEARCH_PASSWORD=
OPENSEARCH_AI_CONNECTION_TIMEOUT_SECONDS=720
OPENSEARCH_AI_READ_TIMEOUT_SECONDS=1440
OPENSEARCH_AI_DEPLOY_TIMEOUT_SECONDS=360
OPENSEARCH_AI_MAX_TOKENS=16384
OPENSEARCH_AI_UTILITY_MAX_TOKENS=16384
OPENSEARCH_AI_REASONING_EFFORT=none
# Leave room for discovery, one bounded retry, and result summarization.
OPENSEARCH_AI_CHAT_MAX_ITERATIONS=8
# Hard cap on rows returned by the chat assistant's executing PPL tool.
OPENSEARCH_AI_PPL_RESULT_LIMIT=100

# Stable resource names let scripts/opensearch-ai-init.sh safely find and
# update resources instead of creating duplicates on every run.
OPENSEARCH_AI_CHAT_CONNECTOR_NAME="Ollama Qwen Agent Connector"
OPENSEARCH_AI_CHAT_MODEL_NAME="Qwen 3.5 Ollama Agent Model"
OPENSEARCH_AI_CHAT_AGENT_NAME="Qwen 3.5 Conversational Agent v2"
OPENSEARCH_AI_ROOT_AGENT_NAME="Qwen Dashboards Root Agent"
OPENSEARCH_AI_PPL_CONNECTOR_NAME="Ollama Qwen PPL Connector"
OPENSEARCH_AI_PPL_MODEL_NAME="Qwen 3.5 Ollama PPL Model"
OPENSEARCH_AI_PPL_AGENT_NAME="Qwen PPL Query Assist Agent"
OPENSEARCH_AI_TIME_RANGE_CONNECTOR_NAME="Ollama Qwen Time Range Connector"
OPENSEARCH_AI_TIME_RANGE_MODEL_NAME="Qwen 3.5 Ollama Time Range Model"
OPENSEARCH_AI_TIME_RANGE_AGENT_NAME="Qwen Query Time Range Parser Agent"
OPENSEARCH_AI_UTILITY_CONNECTOR_NAME="Ollama Qwen Dashboards Utility Connector"
OPENSEARCH_AI_UTILITY_MODEL_NAME="Qwen 3.5 Dashboards Utility Model"
OPENSEARCH_AI_AD_CONNECTOR_NAME="Ollama Qwen Anomaly Suggestion Connector"
OPENSEARCH_AI_AD_MODEL_NAME="Qwen 3.5 Anomaly Suggestion Model"
OPENSEARCH_AI_VISUAL_CONNECTOR_NAME="Ollama Qwen Visualization Connector"
OPENSEARCH_AI_VISUAL_MODEL_NAME="Qwen 3.5 Visualization Model"

# disables swapping, imporving r/w performance (at the expense of RAM)
OPENSEARCH_BOOTSTRAP_MEMORY_LOCK=true

#  system_call_filter | https://en.wikipedia.org/wiki/Seccomp
OPENSEARCH_SYSTEM_CALL_FILTER=false

####### OpenID Connect (OpenSearch Security) #######
# Values used by: security/es_roles/opensearch/config.yml (openid_auth_domain)
OPENSEARCH_OPENID_CONNECT_URL="https://keycloak.example.com:8080/auth/realms/master/.well-known/openid-configuration"
OPENSEARCH_OPENID_REQUIRED_AUDIENCE="your-openid-client-id"
OPENSEARCH_OPENID_SUBJECT_KEY="preferred_username"
OPENSEARCH_OPENID_ROLES_KEY="roles"

####### This section is for AD user authentication #######

# example: network.xyz.uk
OPENSEARCH_AD_DOMAIN_NAME="network.xyz.uk"

# example: "ldap://server1.xyz.uk:389,ldap://server2.xyz.uk:389"
OPENSEARCH_AD_URL="ldap://server1.xyz.uk:389,ldap://server2.xyz.uk:389"

OPENSEARCH_AD_UNMAPPED_GROUPS_AS_ROLES=true
OPENSEARCH_AD_FOLLOW_REFERRALS=false

OPENSEARCH_AD_TIMEOUT=60s


####### SMTP EMAIL section 

# example Watcher_Email
OPENSEARCH_EMAIL_ACCOUNT_PROFILE="Watcher_Email"

OPENSEARCH_EMAIL_ACCOUNT_EMAIL_DEFAULTS=info@notifications.cogstack.net

# example: smtpserver.xyz.uk
OPENSEARCH_EMAIL_SMTP_HOST="smtpserver.xyz.uk"
OPENSEARCH_EMAIL_SMTP_PORT=25


# Other elasticsearch settings, important for indexing etc
OPENSEARCH_QUERY_BOOL_MAX_CLAUSE_COUNT=4096
OPENSEARCH_INDICES_MEMORY_INDEX_BUFFER_SIZE="25%"


##########################################################

############################################################ Shared Env vars for MetricBeats/Kibana etc ##############################################################

# please respect the double quotes "" on each address or you may get type errors from Kibana
OPENSEARCH_HOSTS='["https://elasticsearch-1:9200","https://elasticsearch-2:9200"]'

# You can generate values for the below strings by using openssl rand
# example, in bash:  openssl rand -base64 32
# the keys must be at least 32 characters long

# xpack.security.encryptionKey: "something_at_least_32_characters"
# OPENSEARCH_XPACK_SECURITY_ENCRYPTION_KEY=

